# The voraus-AD dataset (CC BY-NC-SA 4.0) is downloaded by the user, never committed.
data/

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Regenerated by the pipeline and too large to version (~17 GB in total):
#   rendered benchmark images (05), anomaly maps (06), resampled / native-length
#   signal caches (01, 01b, 19), all of which are copies or renderings of the dataset.
results/**/*.npy
results/**/*.npz
# ...except the 10 KB frozen encoder context that every rendering step reads
!results/02_context/context.npz

# Written by each invocation of 08_diagnose_controls.py; the release keeps the
# merged control_sweep_all.csv
results/08_diagnose/control_sweep.csv

# Trained model weights and anomaly-map attribution tables are not released
# (see README, "What is not in this repository").
*.pth
results/04_mvtflow_repro/
results/10_attribution/

# Console logs of individual runs
results/**/*.log
